# Required to enable registration, sessions, conversations, search, and the Bot API.
# Use a managed PostgreSQL database in the same region as your Vercel functions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public application origin used to create email links; never put secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. If both are configured, email verification and password recovery are enabled.
RESEND_API_KEY=
EMAIL_FROM=Ravan <no-reply@example.com>

# Object storage is intentionally not enabled in this first vertical slice.
# Add a private S3-compatible provider before implementing media uploads.
